{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engiverify/document-profile.schema.json",
  "title": "EngiVerify Document Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "name",
    "version",
    "document_type",
    "status",
    "fields"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "UNDER_VALIDATION",
        "APPROVED",
        "RETIRED"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_name",
          "page_number",
          "bbox"
        ],
        "properties": {
          "field_name": {
            "type": "string",
            "minLength": 1
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "data_type": {
            "type": "string"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
