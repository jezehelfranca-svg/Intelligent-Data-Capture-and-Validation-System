{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engiverify/telecom-extraction-bundle.schema.json",
  "title": "EngiVerify Telecom Extraction Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "project_id",
    "generated_at",
    "source_documents",
    "extracted_fields",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "engiverify.telecom.v1"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "EngiVerify"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "extracted_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "extraction_id",
          "source_document_id",
          "field_name",
          "original_value",
          "page_number",
          "bounding_box",
          "extraction_method"
        ],
        "properties": {
          "extraction_id": {
            "type": "string"
          },
          "source_document_id": {
            "type": "string"
          },
          "field_name": {
            "type": "string"
          },
          "original_value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "bounding_box": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "extraction_method": {
            "type": "string"
          },
          "extraction_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "profile_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "authority": {
      "const": "human_validation_required"
    }
  }
}
