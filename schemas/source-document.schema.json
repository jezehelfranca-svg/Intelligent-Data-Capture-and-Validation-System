{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engiverify/source-document.schema.json",
  "title": "EngiVerify Source Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_document_id",
    "project_id",
    "original_filename",
    "sha256",
    "size_bytes",
    "media_type",
    "document_type",
    "document_revision",
    "registered_at"
  ],
  "properties": {
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "original_filename": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "document_revision": {
      "type": "string",
      "minLength": 1
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
